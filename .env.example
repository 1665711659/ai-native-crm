# ============================================================
# AI原生CRM 环境配置示例
# ------------------------------------------------------------
# 使用方法：复制本文件为 .env 并按需修改
#   Windows: copy .env.example .env
#   Linux:   cp .env.example .env
#
# ★ 所有项均可留空 —— 自动进入「离线演示模式」全链路可跑
#   （LLM 走 Mock 规则模拟、Embedding 走本地向量、SQLite 演示库）
# ============================================================

# ============================================================
# 一、LLM 大模型（OpenAI 兼容协议，任选一家）
# ============================================================

# ---------- 方案A：火山方舟（默认，支持 doubao 直连模型名）----------
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_API_KEY=
# 模型名直连（如 doubao-seed-evolving-v1.5），或控制台「在线推理」接入点 ep-2024xxxx
LLM_MODEL=doubao-seed-evolving-v1.5
# Embedding 模型（如 doubao-embedding-large）；留空=本地Mock向量（离线检索演示）
EMBEDDING_MODEL=

# ---------- 方案B：DeepSeek（取消注释并注释掉方案A三项）----------
# LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=
# LLM_MODEL=deepseek-chat

# ---------- 方案C：智谱GLM ----------
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_API_KEY=
# LLM_MODEL=glm-4-flash

# ---------- 方案D：Kimi 月之暗面 ----------
# LLM_BASE_URL=https://api.moonshot.cn/v1
# LLM_API_KEY=
# LLM_MODEL=moonshot-v1-8k

# ============================================================
# 二、数据库（DB_BACKEND 决定后端）
# ============================================================

# sqlite = 零配置演示库（默认）；mysql = 生产库（需下方连接信息）
DB_BACKEND=sqlite
SQLITE_PATH=data/crm.db

# ---- MySQL 配置（DB_BACKEND=mysql 时生效；先建库：
#      CREATE DATABASE ai_crm DEFAULT CHARSET utf8mb4;）----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=ai_crm

# PostgreSQL：见 README 7.5 节（实现 asyncpg 门面后切换）

# ============================================================
# 三、Web 服务
# ============================================================
PORT=8888
# DEBUG=1 开启自动重载与详细错误（开发）；生产设为 0
DEBUG=1

# ============================================================
# 四、AIGC 能力（app/ai/aigc，按需启用）
# ============================================================
# ComfyUI 服务地址（文生图/图生视频素材生成）
COMFYUI_URL=http://127.0.0.1:8188
# FFmpeg 可执行文件路径（在 PATH 中则保持默认）
FFMPEG_PATH=ffmpeg
# TTS：默认使用免费 Edge-TTS，无需配置；如接火山方舟TTS，
#      在 app/ai/aigc/tts.py 中切换 ArkTTSProvider 并配置模型名

# ============================================================
# 五、数字员工（app/ai/digital_employee，按需安装扩展依赖）
# ============================================================
# Playwright / Browser-use：安装后自动生效，无额外配置
#   pip install playwright && playwright install chromium
#   pip install browser-use            # 需上方 LLM_API_KEY
# Airtest：连接设备后调用 run_followup_batch()，无额外配置
#   pip install airtest
COMFYUI_CHECKPOINT=sd_xl_base_1.0.safetensors  # 改为你本机 checkpoints 目录下实际模型名
